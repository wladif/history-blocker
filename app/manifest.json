{
	"manifest_version": 3,
	"name": "History Blocker",
	"version": "1.0.1",
	"description": "Automatically removes visits to blocked domains from your browser history.",
	"permissions": [
		"history",
		"storage",
		"tabs"
	],
	"background": {
		"scripts": [
			"background.js"
		]
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "@history-blocker",
			"strict_min_version": "142.0",
			"data_collection_permissions": {
				"required": [
					"none"
				],
				"optional": []
			}
		}
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"64": "icons/icon64.png",
			"96": "icons/icon96.png"
		},
		"default_title": "History Blocker"
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"64": "icons/icon64.png",
		"96": "icons/icon96.png"
	}
}